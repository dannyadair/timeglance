<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: {{ paper }} landscape; margin: 9mm; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
    -weasy-hyphens: none;
    --bg: {{ theme.bg }}; --text: {{ theme.text }}; --muted: {{ theme.muted }};
    --line: {{ theme.line }}; --line-major: {{ theme.line_major }};
    --border: {{ theme.border }}; --cell-border: {{ theme.cell_border }};
    --head-bg: {{ theme.head_bg }}; --today-bg: {{ theme.today_bg }};
    --today-text: {{ theme.today_text }}; --today-tint: {{ theme.today_tint }};
    background: var(--bg); color: var(--text);
  }
  .sheet { display: flex; flex-direction: column; }

  header { flex: none; display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 8px; }
  header h1 { font-size: 22px; margin: 0 0 6px; font-weight: 700; }
  header .meta { text-align: right; font-size: 11px; color: var(--muted); }
  header .meta .sub { font-size: 13px; color: var(--text); }

  .legend { font-size: 10px; line-height: 1.6; }
  .legend .item { display: inline-block; margin: 0 16px 0 0; white-space: nowrap; }
  .legend .swatch { width: 11px; height: 11px; border-radius: 3px; display: inline-block; vertical-align: -1px; margin-right: 5px; }
  .legend .hrs { color: var(--muted); font-weight: 400; margin-left: 4px; }

  .block { position: absolute; border-radius: 4px; padding: 2px 5px; overflow: hidden; color: #fff;
           box-shadow: inset 0 0 0 1px rgba(0,0,0,0.08); }
  .block .t { font-size: 8px; opacity: 0.9; line-height: 1.1; }
  .block .l { font-size: 10px; font-weight: 600; line-height: 1.15; }

{% if layout == 'horizontal' %}
  /* Days as rows, time running left to right. */
  .grid { display: grid; grid-template-rows: 22px repeat({{ days | length }}, 1fr);
          height: {{ track_h }}mm; border: 1px solid var(--border); border-top: none; }
  .lane { display: flex; border-top: 1px solid var(--cell-border); min-height: 0; }
  .lane.axis { border-top: none; }
  .rail { width: 42px; flex: none; display: flex; align-items: center; justify-content: center;
          font-size: 12px; font-weight: 600; border-right: 1px solid var(--border); background: var(--head-bg); }
  .lane.axis .rail { background: transparent; }
  .lane.today .rail { background: var(--today-bg); color: var(--today-text); }
  .lane.today .track { background: var(--today-tint); }
  .track { position: relative; flex: 1 1 auto; min-width: 0; }
  .gl { position: absolute; top: 0; bottom: 0; border-left: 1px solid var(--line); }
  .gl.major { border-left: 1px solid var(--line-major); }
  .glabel { position: absolute; top: 3px; transform: translateX(-50%); font-size: 9px; color: var(--muted); }
{% else %}
  /* Days as columns, time running top to bottom. */
  .grid { display: grid; grid-template-columns: 42px repeat({{ days | length }}, 1fr);
          border: 1px solid var(--border); border-left: none; }
  .lane { display: flex; flex-direction: column; border-left: 1px solid var(--cell-border); }
  .lane.axis { border-left: none; }
  .rail { height: 24px; flex: none; display: flex; align-items: center; justify-content: center;
          font-size: 12px; font-weight: 600; border-bottom: 1px solid var(--border); background: var(--head-bg); }
  .lane.axis .rail { background: transparent; }
  .lane.today .rail { background: var(--today-bg); color: var(--today-text); }
  .lane.today .track { background: var(--today-tint); }
  .track { position: relative; height: {{ track_h }}mm; }
  .gl { position: absolute; left: 0; right: 0; border-top: 1px solid var(--line); }
  .gl.major { border-top: 1px solid var(--line-major); }
  .glabel { position: absolute; right: 4px; transform: translateY(-50%); font-size: 9px; color: var(--muted); }
{% endif %}

  @media screen {
    html, body { height: 100%; }
    .sheet { height: 100%; padding: 9mm; }
{% if layout == 'horizontal' %}
    .grid { height: auto; flex: 1 1 auto; min-height: 0; }
{% else %}
    .grid { flex: 1 1 auto; grid-template-rows: 1fr; min-height: 0; }
    .track { height: auto; flex: 1 1 auto; min-height: 0; }
{% endif %}
  }
</style>
</head>
<body>
  <div class="sheet">
    <header>
      <div>
        <h1>{{ title }}</h1>
        <div class="legend">
          {% for a in legend %}
            <span class="item"><span class="swatch" style="background: {{ a.color }}"></span>{{ a.label }}<span class="hrs">{{ a.hours }}</span></span>
          {% endfor %}
        </div>
      </div>
      <div class="meta">
        {% if subtitle %}<div class="sub">{{ subtitle }}</div>{% endif %}
      </div>
    </header>

    <div class="grid">
      <div class="lane axis">
        <div class="rail"></div>
        <div class="track">
          {% for hl in hour_lines %}
            <div class="glabel" style="{{ 'left' if layout == 'horizontal' else 'top' }}: {{ hl.pos }}%">{{ hl.label }}</div>
          {% endfor %}
        </div>
      </div>
      {% for day in days %}
      <div class="lane {{ 'today' if day == today }}">
        <div class="rail">{{ day }}</div>
        <div class="track">
          {% for hl in hour_lines %}
            <div class="gl {{ 'major' if hl.major }}" style="{{ 'left' if layout == 'horizontal' else 'top' }}: {{ hl.pos }}%"></div>
          {% endfor %}
          {% for a in activities[day] %}
          {% if layout == 'horizontal' %}
            <div class="block" style="left: {{ a.pos }}%; width: {{ a.size }}%; top: calc({{ a.lane_pos }}% + 3px); height: calc({{ a.lane_size }}% - 6px); background: {{ a.color }}">
          {% else %}
            <div class="block" style="top: {{ a.pos }}%; height: {{ a.size }}%; left: calc({{ a.lane_pos }}% + 2px); width: calc({{ a.lane_size }}% - 4px); background: {{ a.color }}">
          {% endif %}
              <div class="t">{{ a.time }}</div>
              <div class="l">{{ a.label }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</body>
</html>
